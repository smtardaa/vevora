---
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { navigation, sectionIds } from '../data/navigation';
import { brand } from '../data/site';
import { getDictionary, type Locale } from '../i18n';
import { withBase } from '../utils/url';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<!--
  DOM sırası: logo, menü butonu, menü, dil seçici.
  Geniş düzende eşit yan kolonlu grid sayesinde menü header'ın tam ortasında durur.
-->
<header class="site-header" data-nav>
  <div class="container site-header__inner" data-header-inner>
    <a class="site-header__brand" href={`#${sectionIds.top}`} aria-label={t.common.homeLinkLabel} data-header-brand>
      <img
        class="site-header__logo"
        src={withBase(brand.logoSmall.src)}
        width={brand.logoSmall.width}
        height={brand.logoSmall.height}
        alt=""
      />
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      data-nav-toggle
      data-label-open={t.nav.openMenu}
      data-label-close={t.nav.closeMenu}
    >
      <span class="nav-toggle__icon nav-toggle__icon--open"><Icon name="menu" size={22} /></span>
      <span class="nav-toggle__icon nav-toggle__icon--close"><Icon name="close" size={22} /></span>
      <span class="visually-hidden" data-nav-toggle-label>{t.nav.openMenu}</span>
    </button>

    <nav class="site-nav" id="site-menu" aria-label={t.nav.label} data-nav-menu>
      <ul class="site-nav__list" role="list" data-nav-list>
        {
          navigation.map((item) => (
            <li>
              {item.status === 'active' && item.href ? (
                <a class="site-nav__link" href={item.href}>
                  {t.nav.items[item.id]}
                </a>
              ) : (
                <span class="site-nav__link site-nav__link--soon" aria-disabled="true">
                  {t.nav.items[item.id]}
                  <span class="soon-badge">{t.common.soon}</span>
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <LanguageSwitcher locale={locale} />
  </div>
</header>

<!--
  Geniş/dar düzen kararı: menünün doğal genişliği, iki eşit yan kolonla birlikte kapsayıcıya sığıyor mu?
  Dile göre değişen metin uzunluklarını ölçtüğü için sabit bir kırılım noktası gerekmez.
  Header çizildikten hemen sonra eşzamanlı çalışır; JS yoksa CSS dar düzeni kullanır.
-->
<script is:inline>
  (() => {
    const header = document.querySelector('[data-nav]');
    const inner = header.querySelector('[data-header-inner]');
    const list = header.querySelector('[data-nav-list]');
    const brand = header.querySelector('[data-header-brand]');
    const lang = header.querySelector('[data-lang]');
    let required = Infinity;

    const measure = () => {
      const previous = header.dataset.layout;
      header.dataset.layout = 'wide';
      const gap = parseFloat(getComputedStyle(inner).columnGap) || 0;
      required = list.scrollWidth + 2 * Math.max(brand.offsetWidth, lang.offsetWidth) + 2 * gap;
      if (previous) header.dataset.layout = previous;
    };

    const apply = () => {
      header.dataset.layout = inner.clientWidth >= required ? 'wide' : 'compact';
    };

    measure();
    apply();
    new ResizeObserver(apply).observe(inner);
    if (document.fonts) document.fonts.ready.then(() => { measure(); apply(); });
  })();
</script>
