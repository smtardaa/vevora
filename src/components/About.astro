---
import { sectionIds } from '../data/navigation';
import { brand } from '../data/site';
import { getDictionary, type Locale } from '../i18n';
import { withBase } from '../utils/url';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section class="section section--about" id={sectionIds.about} aria-labelledby="about-title">
  <div class="container">
    <div class="about">
      <div class="about__logo">
        <img
          src={withBase(brand.logoLarge.src)}
          width={brand.logoLarge.width}
          height={brand.logoLarge.height}
          alt={t.common.logoAlt}
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="about__text">
        <h2 class="about__title" id="about-title">{t.about.title}</h2>
        <p class="about__story">{t.about.story}</p>
      </div>
    </div>
    <p class="about__quote">
      {t.about.quote.map((part) => <span>{part}</span>)}
    </p>
  </div>
</section>
